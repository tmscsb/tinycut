{
  "name": "trimkit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --conditions=browser --import ./scripts/register-svelte-tests.mjs --test src/lib/utils/*.test.ts src/lib/stores/*.test.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "verify": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/vite": "4.2.4",
    "@types/node": "24.13.3",
    "axe-core": "^4.13.0",
    "daisyui": "5.6.6",
    "svelte": "5.56.3",
    "svelte-check": "^4.7.6",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
